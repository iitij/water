<?xml version="1.0" encoding="utf-8"?>
<!--
  نسخة الإنتاج: لا اتصال غير مشفّر إطلاقاً (خطة 2.0 — الفصل 9.3).
  شهادة الخادم يجب أن تكون صادرة من جهة موثوقة؛ التطبيق لا يقبل شهادات
  موقّعة ذاتياً في الإنتاج. للاختبار على الشبكة المحلية استخدم نسخة debug.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
