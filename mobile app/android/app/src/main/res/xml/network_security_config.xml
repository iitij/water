<?xml version="1.0" encoding="utf-8"?>
<!--
  يحتاج خادم Laravel المحلي إلى HTTP لعناوين LAN المتغيرة ومحاكي Android.
  لا يدعم إعداد Android نطاقات IP خاصة كاملة، لذا تسمح طبقة النظام بالاتصال
  وتقيّد AppConfig عنوان API إلى loopback / RFC1918 أو HTTPS في release.
  تبقى شهادات HTTPS موثوقة من النظام فقط، بلا شهادات ذاتية أو شهادات مستخدم.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
