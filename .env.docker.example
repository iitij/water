# بيئة Docker للاختبار فقط — لا تحتوي أسراراً حقيقية.
APP_NAME="مشروع مياه الوشاح"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Aden
APP_LOCALE=ar

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=water
DB_USERNAME=water
DB_PASSWORD=water

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
